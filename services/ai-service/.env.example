# NexPlast AI Service (local)
APP_ENV=development
HOST=0.0.0.0
PORT=8001

# Must match AI_SERVICE_API_KEY in the Next.js .env
AI_SERVICE_API_KEY=nexplast-dev-ai-key

# Model versioning (path relative to services/ai-service/)
MODEL_NAME=yolov8n
MODEL_VERSION=8.3.0-n
MODEL_PATH=models/yolov8n.pt
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.45

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_DIMENSION=1280
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Future extension points (unused in Phase 9)
# REDIS_URL=
# ENABLE_BACKGROUND_QUEUE=false
