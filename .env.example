# NexPlast Environment Variables
# Copy to .env and fill in real values. Never commit secrets.

# Database (Neon PostgreSQL)
# Prefer Neon *pooled* URL (host contains `-pooler`). Direct URLs also work —
# the app auto-rewrites to the pooler and caps connection_limit.
DATABASE_URL=""

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI Platform — Gemini vision (free key: https://aistudio.google.com/apikey).
# Optional; Next.js falls back to local analysis if unset.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=45000

# Legacy FastAPI + YOLO service (services/ai-service) — no longer used by Next.js
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_SERVICE_API_KEY="nexplast-dev-ai-key"
# AI_SERVICE_TIMEOUT_MS=60000

# Email (Phase 10) — optional; when unset, emails are logged only
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NexPlast <noreply@nexplast.com>"
