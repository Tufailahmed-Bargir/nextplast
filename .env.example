# NexPlast Environment Variables
# Copy to .env and fill in real values. Never commit secrets.

# Database (Neon PostgreSQL)
# Prefer Neon *pooled* URL (host contains `-pooler`). Direct URLs also work —
# the app auto-rewrites to the pooler and caps connection_limit.
DATABASE_URL=""

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI Platform (Phase 9) — optional; Next.js falls back to local analysis if unset
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_SERVICE_API_KEY="nexplast-dev-ai-key"
# AI_SERVICE_TIMEOUT_MS=60000

# Email (Phase 10) — optional; when unset, emails are logged only
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NexPlast <noreply@nexplast.com>"
